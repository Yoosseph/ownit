# Ownit local development settings. Copy to .env (gitignored) and fill in:
#
#   cp .env.example .env
#
# `npm run dev -w worker` loads this file into `wrangler dev`, and
# scripts/live-injection-check reads it too. In production, set the secrets with
# `wrangler secret put <NAME>` instead; this file is never deployed.

# --- Worker secrets ------------------------------------------------------------

# Random string that seals debrief state between requests. Example: openssl rand -hex 32
SESSION_SECRET=

# Optional shared Nebius key, used only when a request carries no key of its own.
# Capped by DEMO_DAILY_CALL_CAP (wrangler.toml). Leave empty to require each user's key.
DEMO_NEBIUS_KEY=

# From your GitHub App (docs/github-app.md). Put the PEM on one line, with \n for
# each line break, inside double quotes. Both may stay empty until you create the App.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Local-only switches -------------------------------------------------------

# "1" skips the GitHub push-access check, but only for requests to localhost.
# Lets you try Ownit with `wrangler dev` before the GitHub App exists.
DEV_LOCAL_TRUST=1

# "fixture" uses the offline fake model (canned questions, no Nebius calls).
# Leave empty to use real Nemotron on Nebius.
MODEL_BACKEND=

# --- Live checks ---------------------------------------------------------------

# Your own Nebius API key for scripts/live-injection-check.
# (The ownit CLI keeps its key in ~/.ownit/config.json via `ownit key set`.)
NEBIUS_API_KEY=
