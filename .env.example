# Server settings for local development. Copy to .env and fill in.
# In production, set these with `wrangler secret put <NAME>` instead.

# Required. Any long random string, e.g. from `openssl rand -hex 32`.
SESSION_SECRET=

# Optional. A Nebius API key used when a user has none (for demos and judges).
DEMO_NEBIUS_KEY=v1.CmMKHHN0YXRpY2tleS1lMDBwOGQ1ZXJ6Z3doMHhuYTISIXNlcnZpY2VhY2NvdW50LWUwMHE4NmdjYnh3MHFyNjFnMDIMCLyHk9cGEKvf4qMCOgsIt4qrogcQwMXvc0ACWgNlMDA.AAAAAAAAAAGKNRPDH4k5h3VPNRF4-yw8QGYnk8XU50XNcwjpXQfKeltZ8-qXJbxYBOhDxMnY7er4ZXoJ7zfoiXrIumlGPDAC
# From your GitHub App (docs/github-app.md). The private key goes on one line, with \n for line breaks, in quotes.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
