  "code": [
    "export async function chargeWithRetry(pay) {",
    "  const maxAttempts = 3;",
    "  for (let attempt = 1; attempt <= maxAttempts; attempt++) {",
    "    try {",
    "      return await pay();",
    "    } catch (error) {",
    "      if (!error.temporary || attempt === maxAttempts) {",
    "        throw error;",
    "      }",
    "      await sleep(250 * attempt);",
    "    }",
    "  }",
    "}"
