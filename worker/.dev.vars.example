# Local secrets for `wrangler dev`. Copy to .dev.vars (gitignored) and fill in.
# In production, set each with `wrangler secret put <NAME>`.
# Non-secret settings (model, Nebius base URL, GitHub App IDs) live in wrangler.toml.

# Random string used to seal debrief state between requests. Example: openssl rand -hex 32
SESSION_SECRET=

# Optional shared Nebius key, used only when a request carries no key, capped by DEMO_DAILY_CALL_CAP.
DEMO_NEBIUS_KEY=

# From the GitHub App settings (docs/github-app.md). PEM, PKCS#1 or PKCS#8; keep the line breaks as \n.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
